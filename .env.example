# ESTA configuration — copy to `.env` and adjust.
# These map to environment variables; see src/esta/api/server.py for usage.

# HuggingFace model id. Default is Qwen 2.5 7B Instruct (ungated).
# For Llama 3.1 8B (gated), you also need HF_TOKEN below.
ESTA_MODEL=Qwen/Qwen2.5-7B-Instruct

# cuda | cpu. Default: cuda if available, else cpu.
ESTA_DEVICE=cuda

# Path to the refusal-direction tensor produced by:
#   python -m esta.scripts.extract_refusal_direction
ESTA_REFUSAL_DIR=data/refusal_direction.pt

# Layer index for residual-stream extraction. Arditi et al. (2024) found
# middle layers most informative; layer 14 is a reasonable default for
# 7B-class models. Must match the layer used during extraction.
ESTA_REFUSAL_LAYER=14

# Audit log directory. Created if missing. JSONL files rotate daily.
# For production deployments, set this to a path on durable, monitored
# storage with retention configured per your records-management policy.
ESTA_AUDIT_DIR=audit_logs

# HuggingFace access token. Required only for gated models (e.g., Llama 3.1).
# Get one at https://huggingface.co/settings/tokens
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx
